# Puerto HTTP donde escuchará el panel.
PUERTO=3000

# Entorno de ejecución de Node.js.
ENTORNO=produccion

# Usa true cuando el panel se sirve mediante HTTPS.
COOKIE_SECURE=true

# Nombre local del administrador; reemplázalo por el usuario elegido.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
CUENTAS_API_SECRETO=

# ARCHIVO_USUARIOS se conserva solo como origen de migración hacia SQLite/PDO.
ARCHIVO_USUARIOS=./datos/usuarios.json
RUTA_DATOS_PANEL=/srv/panel/datos-panel

# Configura estos valores según el usuario y grupo creados en Debian.
PANEL_UID=1000
PANEL_GID=1000
DOCKER_GID=999
RUTA_PROYECTOS=/srv/panel/proyectos
